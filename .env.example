# Copy this file to .env (never commit .env). Every value is read once at start-up.

# ---- Core -------------------------------------------------------------------------------------
APP_ENV=development                # development | production | testing
SECRET_KEY=change-me               # REQUIRED in production, 32+ characters, and "change-me" is refused: python -c "import secrets; print(secrets.token_hex(32))"
HOST=127.0.0.1
PORT=5000

# Dev uses SQLite (instance/dev.db). Production needs PostgreSQL.
# DEV_DATABASE_URL=sqlite:///dev.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_smart_shopper

# ---- Retail price data (Step 6). mock = offline sample data (default) | loyaltyhub | buyly | apify | parsebot
# Keys can also be pasted into the admin portal (Integrations); a key saved there wins over these.
# The mock catalogue has no real product photos. For real photos, prices and barcodes use loyaltyhub.
RETAIL_PROVIDER=mock
# LoyaltyHub (https://loyaltyhub.co.za/developers): free key = 100 calls a month, so answers refresh every 15 minutes.
LOYALTYHUB_API_KEY=
# LOYALTYHUB_CACHE_TTL=900
# LOYALTYHUB_PAGE_SIZE=100          # rows per search (one call each); the API allows up to 500
# Buyly (closed beta, key by application; response format not public, so this connector is untested).
BUYLY_API_KEY=
# BUYLY_CACHE_TTL=3600
APIFY_API_TOKEN=
# One entry per retailer. Take the actor name and input field names from the actor's page on apify.com (Input tab).
# {query} {lat} {lng} {radius_km} {category} are filled in for each search. Example shape:
#   {"checkers": {"actor": "sirgrant11788~sa-sixty60-search", "input": {"search": "{query}"}}}
# Optional per retailer: "field_map": {"name": "title", "price": "amount"}, "price_in_cents": true
APIFY_ACTORS_JSON=
APIFY_RUN_TIMEOUT=120
PARSEBOT_API_KEY=
# A Woolworths scraper is built in. Add more as {"pnp": "<scraper id>"}
PARSEBOT_SCRAPERS_JSON=

# ---- Sign in with Microsoft (Azure App Registration). Redirect URI to register:
#      http://localhost:5000/auth/azure/authorized     (https://<your-domain>/auth/azure/authorized in production)
# MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET / MICROSOFT_TENANT are accepted as well.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---- Redis: shared cache and shared rate-limit counters. Leave empty to use per-process memory. -----
# With several gunicorn workers set this, otherwise every worker counts on its own.
# REDIS_URL=redis://localhost:6379/0
# CACHE_TYPE=SimpleCache           # RedisCache is chosen automatically when REDIS_URL is set
# RATELIMIT_AUTH=20 per minute     # POST /login and /register, per IP
# RATELIMIT_API=240 per minute     # every /api route, per student

# ---- Weather (Open-Meteo, free, no key) and route (OSRM). The defaults are the public servers, for light use only.
# OPEN_METEO_URL=https://api.open-meteo.com/v1
# OSRM_BASE_URL=https://router.project-osrm.org
# Nominatim (OpenStreetMap geocoder) requires an identifying User-Agent. Put a contact e-mail in it.
NOMINATIM_USER_AGENT=AISmartShopper/1.0 (you@example.com)

# ---- Production behind a proxy (Heroku, Render, Railway, Fly): the defaults are right. -------------
# FORCE_HTTPS=1                    # redirect http to https, send HSTS, mark cookies Secure (set 0 for a local http trial)
# TRUST_PROXY=1                    # believe X-Forwarded-For / -Proto from ONE proxy in front of the app
# USE_WHITENOISE=1                 # gunicorn serves /static itself
# HSTS_SECONDS=31536000
# WEB_CONCURRENCY=2                # gunicorn workers
# GUNICORN_TIMEOUT=150             # seconds; default is APIFY_RUN_TIMEOUT + 30 (see gunicorn.conf.py)
# API_LOG_FILE=app/logs/api_calls.log   # feeds "API calls today" on the admin dashboard

# ---- Other settings ---------------------------------------------------------------------------------
# Admin access is a flag on the user. Create the first admin with:  flask make-admin you@example.com
# Optional: a separate secret for encrypting API keys typed into the admin portal (defaults to SECRET_KEY)
SETTINGS_ENCRYPTION_KEY=
# Secret used to fingerprint South African ID numbers (HMAC). Falls back to SECRET_KEY. Keep it stable once
# real users exist: changing it makes old fingerprints unmatchable.
ID_HASH_PEPPER=
BCRYPT_LOG_ROUNDS=12
# Also ask DNS whether the e-mail domain exists when someone registers (off by default)
# EMAIL_DNS_CHECK=1
